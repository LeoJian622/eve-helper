# Eve Helper 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# 数据库连接配置
DB_HOST=localhost
DB_PORT=3306
DB_SYSTEM_USERNAME=your_username
DB_SYSTEM_PASSWORD=your_system_db_password
DB_EVE_USERNAME=your_username
DB_EVE_PASSWORD=your_eve_db_password

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT密钥库配置(007:生产密钥外置,不随源码分发)
# 生产 profile:必须是文件系统绝对路径(如 /etc/eve-helper/eve-jwt.jks,权限 600);
# classpath/裸文件名会被 SecurityBaselineValidator 拒绝启动(fail-closed)。
# test profile:使用 classpath:test-only.jks(入库测试密钥,勿用于生产)。
KEYSTORE_LOCATION=/etc/eve-helper/eve-jwt.jks
KEYSTORE_ALIAS=eve-jwt
KEYSTORE_PASSWORD=your_keystore_password
KEY_PASSWORD=your_key_password

ONEBOT_WEBSOCKET_SECRET=your_websocket_secret

# 角色 ESI accessToken 查询端点开关(006 feature)
# 该端点返回可直接冒用的 ESI bearer 凭证，仅供内部调试/运维排查。
# 生产环境必须保持 false；需排查时临时置 true 并在排查结束后立即关闭。
ACCESS_TOKEN_ENDPOINT_ENABLED=false
